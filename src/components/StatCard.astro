---
interface Props {
  value: string;
  label: string;
  suffix?: string;
}

const { value, label, suffix = '' } = Astro.props;
---

<div class="stat-card flex flex-col items-center gap-2 p-6 rounded-2xl border border-[#ffffff10] bg-[#ffffff03] text-center group hover:border-[#1251B5]/40 transition-all duration-500">
  <span class="stat-value text-5xl font-extrabold text-white">
    {value}<span class="text-[#1251B5]">{suffix}</span>
  </span>
  <span class="text-sm text-[#ffffff60] font-light tracking-wide uppercase">{label}</span>
</div>
